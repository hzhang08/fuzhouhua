[
  {
    "start": 5.25,
    "end": 6.75,
    "text": "常常讲有味"
  },
  {
    "start": 6.75,
    "end": 8.0,
    "text": "日日都开心"
  },
  {
    "start": 8.0,
    "end": 9.75,
    "text": "观众朋友大家好"
  },
  {
    "start": 9.75,
    "end": 13.5,
    "text": "欢迎收看闽侯电视台福州话节目《讲有味》"
  },
  {
    "start": 13.5,
    "end": 16.0,
    "text": "今天邀请了两位朋友"
  },
  {
    "start": 16.0,
    "end": 18.75,
    "text": "这位是老高这位是施老师"
  },
  {
    "start": 18.75,
    "end": 20.25,
    "text": "一起来这里讲有味"
  },
  {
    "start": 20.25,
    "end": 23.75,
    "text": "观众朋友大家好"
  },
  {
    "start": 23.75,
    "end": 27.75,
    "text": "观众朋友我们上次讲了韩信故事"
  },
  {
    "start": 27.75,
    "end": 33.25,
    "text": "和从韩信的故事造出的成语"
  },
  {
    "start": 33.25,
    "end": 35.5,
    "text": "因为韩信的故事比较多"
  },
  {
    "start": 35.5,
    "end": 37.0,
    "text": "前面我们讲到"
  },
  {
    "start": 37.0,
    "end": 40.5,
    "text": "韩信联合两个对项羽不满的大将"
  },
  {
    "start": 40.5,
    "end": 42.0,
    "text": "攻打项羽"
  },
  {
    "start": 42.0,
    "end": 44.5,
    "text": "独当一面的故事"
  },
  {
    "start": 44.5,
    "end": 48.5,
    "text": "我们今天继续说韩信的故事"
  },
  {
    "start": 48.5,
    "end": 54.0,
    "text": "韩信在刘邦手下最著名的一场大战"
  },
  {
    "start": 54.0,
    "end": 61.75,
    "text": "就是在现在安徽灵壁东南沱河北岸这个地方"
  },
  {
    "start": 61.75,
    "end": 67.25,
    "text": "当时称垓下垓下之战很出名"
  },
  {
    "start": 67.25,
    "end": 73.0,
    "text": "韩信将项羽的军队团团围住"
  },
  {
    "start": 73.0,
    "end": 76.25,
    "text": "形成十面埋伏之势"
  },
  {
    "start": 76.25,
    "end": 81.0,
    "text": "项羽不甘心失败"
  },
  {
    "start": 81.0,
    "end": 82.5,
    "text": "奋起反攻"
  },
  {
    "start": 82.5,
    "end": 86.25,
    "text": "于是在垓下战场杀声震天"
  },
  {
    "start": 86.25,
    "end": 90.25,
    "text": "你死我活两军拼杀"
  },
  {
    "start": 90.25,
    "end": 93.75,
    "text": "著名的垓下之战就是这样展开"
  },
  {
    "start": 93.75,
    "end": 96.5,
    "text": "项羽虽然奋起反攻"
  },
  {
    "start": 96.5,
    "end": 99.25,
    "text": "想突围逃走"
  },
  {
    "start": 99.25,
    "end": 105.5,
    "text": "但是韩信带领三十万军兵围在四周"
  },
  {
    "start": 105.5,
    "end": 107.75,
    "text": "怎能逃脱"
  },
  {
    "start": 107.75,
    "end": 110.75,
    "text": "为了加速项羽的失败"
  },
  {
    "start": 110.75,
    "end": 120.25,
    "text": "刘邦命令围困项羽的士兵唱起楚歌"
  },
  {
    "start": 120.25,
    "end": 123.5,
    "text": "项羽听了心中大惊"
  },
  {
    "start": 123.5,
    "end": 131.75,
    "text": "心想难道我的楚国大地已被刘邦占领"
  },
  {
    "start": 131.75,
    "end": 135.75,
    "text": "会有这么多楚人唱楚歌"
  },
  {
    "start": 135.75,
    "end": 139.75,
    "text": "项羽就心冷意灰"
  },
  {
    "start": 139.75,
    "end": 144.75,
    "text": "他在军帐里喝酒唱歌"
  },
  {
    "start": 144.75,
    "end": 146.75,
    "text": "力拔山兮气盖世"
  },
  {
    "start": 146.75,
    "end": 150.0,
    "text": "时不利兮骓不逝"
  },
  {
    "start": 150.0,
    "end": 152.25,
    "text": "骓不逝兮可奈何"
  },
  {
    "start": 152.25,
    "end": 155.25,
    "text": "虞兮虞兮奈若何"
  },
  {
    "start": 155.25,
    "end": 159.25,
    "text": "项羽的爱妾也跟着唱"
  },
  {
    "start": 159.25,
    "end": 160.5,
    "text": "唱什么呢"
  },
  {
    "start": 160.5,
    "end": 162.75,
    "text": "汉兵已略地"
  },
  {
    "start": 162.75,
    "end": 165.0,
    "text": "四方楚歌声"
  },
  {
    "start": 165.0,
    "end": 166.75,
    "text": "大王意气尽"
  },
  {
    "start": 166.75,
    "end": 169.0,
    "text": "贱妾何聊生"
  },
  {
    "start": 169.0,
    "end": 172.5,
    "text": "虞姬唱完就拔剑自刎"
  },
  {
    "start": 172.5,
    "end": 174.5,
    "text": "项羽见大势已去"
  },
  {
    "start": 174.5,
    "end": 177.75,
    "text": "就带了八百骑兵连夜突围逃走"
  },
  {
    "start": 177.75,
    "end": 184.75,
    "text": "最后被刘邦追赶到乌江边"
  },
  {
    "start": 184.75,
    "end": 190.0,
    "text": "就是现在安徽和县东北乌江浦"
  },
  {
    "start": 190.0,
    "end": 193.0,
    "text": "项羽也拔剑自刎"
  },
  {
    "start": 193.0,
    "end": 196.75,
    "text": "韩信率兵围困项羽"
  },
  {
    "start": 196.75,
    "end": 199.0,
    "text": "促使项羽拔剑自刎"
  },
  {
    "start": 199.0,
    "end": 200.75,
    "text": "就留下了两个成语"
  },
  {
    "start": 200.75,
    "end": 203.0,
    "text": "一个四面楚歌"
  },
  {
    "start": 203.0,
    "end": 205.75,
    "text": "还有一个十面埋伏"
  },
  {
    "start": 205.75,
    "end": 208.5,
    "text": "还有一个成语“背水一战”"
  },
  {
    "start": 208.5,
    "end": 213.75,
    "text": "也是出自韩信指挥的一场著名的战争"
  },
  {
    "start": 213.75,
    "end": 215.25,
    "text": "没错"
  },
  {
    "start": 215.25,
    "end": 219.25,
    "text": "“背水一战”这个典故的背景"
  },
  {
    "start": 219.25,
    "end": 222.5,
    "text": "就是当时韩信兵少"
  },
  {
    "start": 222.5,
    "end": 226.5,
    "text": "项羽兵多"
  },
  {
    "start": 226.5,
    "end": 228.25,
    "text": "韩信去攻打赵国"
  },
  {
    "start": 228.25,
    "end": 230.75,
    "text": "打赵国的时候赵国兵多"
  },
  {
    "start": 230.75,
    "end": 232.0,
    "text": "韩信兵少"
  },
  {
    "start": 232.0,
    "end": 235.0,
    "text": "少能胜多"
  },
  {
    "start": 235.0,
    "end": 242.0,
    "text": "以少胜多要采取有效的战术"
  },
  {
    "start": 242.0,
    "end": 245.5,
    "text": "古代兵家大忌"
  },
  {
    "start": 245.5,
    "end": 247.5,
    "text": "背水布阵"
  },
  {
    "start": 247.5,
    "end": 251.75,
    "text": "背后是水兵布在这里没地方退"
  },
  {
    "start": 251.75,
    "end": 253.5,
    "text": "没有退路"
  },
  {
    "start": 253.5,
    "end": 257.0,
    "text": "兵不灵活只能死战"
  },
  {
    "start": 257.0,
    "end": 259.5,
    "text": "他就是因为布了这样的阵"
  },
  {
    "start": 259.5,
    "end": 264.0,
    "text": "背水一战的时候才能打赢"
  },
  {
    "start": 264.0,
    "end": 270.75,
    "text": "结果赵国一看你这韩信也没什么计谋"
  },
  {
    "start": 270.75,
    "end": 276.0,
    "text": "会布下这样的阵法一般就是大忌"
  },
  {
    "start": 276.0,
    "end": 278.25,
    "text": "人家都不会这样布阵"
  },
  {
    "start": 278.25,
    "end": 280.0,
    "text": "就笑他傻子"
  },
  {
    "start": 280.0,
    "end": 284.0,
    "text": "结果韩信的部队很勇敢"
  },
  {
    "start": 284.0,
    "end": 285.75,
    "text": "只剩去拼才会赢"
  },
  {
    "start": 285.75,
    "end": 290.5,
    "text": "很勇敢打得赵国大败"
  },
  {
    "start": 290.5,
    "end": 292.25,
    "text": "取得大胜利"
  },
  {
    "start": 292.25,
    "end": 296.5,
    "text": "这句成语就由这个典故而来的"
  },
  {
    "start": 296.5,
    "end": 299.0,
    "text": "“背水一战”"
  },
  {
    "start": 299.0,
    "end": 303.0,
    "text": "有句俗语说进一步逼虎伤人"
  },
  {
    "start": 303.0,
    "end": 306.0,
    "text": "韩信将军队布置在河边"
  },
  {
    "start": 306.0,
    "end": 307.5,
    "text": "面临大敌"
  },
  {
    "start": 307.5,
    "end": 310.75,
    "text": "就是逼军队在死中求生"
  },
  {
    "start": 310.75,
    "end": 314.5,
    "text": "以此激发军队的斗志反败为胜"
  },
  {
    "start": 314.5,
    "end": 320.0,
    "text": "由此可见韩信确实是一个有雄才大略的将才"
  },
  {
    "start": 320.0,
    "end": 324.5,
    "text": "刘邦看见韩信这样有勇有谋"
  },
  {
    "start": 324.5,
    "end": 326.0,
    "text": "立下大功"
  },
  {
    "start": 326.0,
    "end": 328.0,
    "text": "肯定很相信他吧"
  },
  {
    "start": 328.0,
    "end": 334.0,
    "text": "开头刘邦确实很看重韩信"
  },
  {
    "start": 334.0,
    "end": 337.25,
    "text": "经常和韩信谈心"
  },
  {
    "start": 337.25,
    "end": 339.25,
    "text": "征求韩信的意见"
  },
  {
    "start": 339.25,
    "end": 343.75,
    "text": "有一次刘邦问韩信"
  },
  {
    "start": 343.75,
    "end": 348.75,
    "text": "萧丞相屡次推荐将军"
  },
  {
    "start": 348.75,
    "end": 351.5,
    "text": "将军你肯定有妙计"
  },
  {
    "start": 351.5,
    "end": 354.75,
    "text": "请将军你指教指教"
  },
  {
    "start": 354.75,
    "end": 356.75,
    "text": "韩信回答说"
  },
  {
    "start": 356.75,
    "end": 361.0,
    "text": "我曾在项王手下做过事知道他的本事如何"
  },
  {
    "start": 361.0,
    "end": 365.0,
    "text": "也知道他的缺点弱点"
  },
  {
    "start": 365.0,
    "end": 374.0,
    "text": "项王喝一声上千的人都会给他吓倒"
  },
  {
    "start": 374.0,
    "end": 377.75,
    "text": "你看他多么勇多么狠"
  },
  {
    "start": 377.75,
    "end": 379.75,
    "text": "但是你不知道"
  },
  {
    "start": 379.75,
    "end": 381.5,
    "text": "他有一点"
  },
  {
    "start": 381.5,
    "end": 383.75,
    "text": "他不能接受别人的意见"
  },
  {
    "start": 383.75,
    "end": 388.25,
    "text": "不能重用有本领的将领"
  },
  {
    "start": 388.25,
    "end": 391.0,
    "text": "他的勇不过是匹夫之勇罢了"
  },
  {
    "start": 391.0,
    "end": 397.5,
    "text": "表面看起来项羽待人又恭敬又有爱心"
  },
  {
    "start": 397.5,
    "end": 399.25,
    "text": "待人很好"
  },
  {
    "start": 399.25,
    "end": 401.75,
    "text": "说话比较温和"
  },
  {
    "start": 401.75,
    "end": 406.0,
    "text": "看见别人病了他会掉眼泪"
  },
  {
    "start": 406.0,
    "end": 412.0,
    "text": "也会把自己吃的喝的分给病人"
  },
  {
    "start": 412.0,
    "end": 416.75,
    "text": "但是如果人家立了大功"
  },
  {
    "start": 416.75,
    "end": 421.75,
    "text": "本来应当封爵位的"
  },
  {
    "start": 421.75,
    "end": 423.25,
    "text": "但是他不封"
  },
  {
    "start": 423.25,
    "end": 424.75,
    "text": "这点很坏"
  },
  {
    "start": 424.75,
    "end": 429.25,
    "text": "就是封了他还舍不得把印交给人家"
  },
  {
    "start": 429.25,
    "end": 438.75,
    "text": "他的好心只不过是婆婆妈妈的好心罢了"
  },
  {
    "start": 438.75,
    "end": 445.5,
    "text": "接着韩信又分析了项羽的一些弱点和错误"
  },
  {
    "start": 445.5,
    "end": 450.5,
    "text": "指出刘邦必然能战胜项羽"
  },
  {
    "start": 450.5,
    "end": 452.25,
    "text": "刘邦听了很高兴"
  },
  {
    "start": 452.25,
    "end": 455.5,
    "text": "由韩信这一次回答刘邦的话中"
  },
  {
    "start": 455.5,
    "end": 460.25,
    "text": "讲到的项羽只是婆婆妈妈的好心"
  },
  {
    "start": 460.25,
    "end": 462.75,
    "text": "于是就引出一句成语"
  },
  {
    "start": 462.75,
    "end": 464.75,
    "text": "妇人之仁"
  },
  {
    "start": 464.75,
    "end": 469.5,
    "text": "意思是做事优柔寡断不识大体"
  },
  {
    "start": 469.5,
    "end": 473.0,
    "text": "没有全局意识"
  },
  {
    "start": 473.0,
    "end": 476.25,
    "text": "这就是说的“妇人之仁”"
  },
  {
    "start": 476.25,
    "end": 477.0,
    "text": "是这样的"
  },
  {
    "start": 477.0,
    "end": 480.25,
    "text": "楚霸王是很勇敢"
  },
  {
    "start": 480.25,
    "end": 486.75,
    "text": "他喜欢一个人单枪匹马的冲进敌营"
  },
  {
    "start": 486.75,
    "end": 490.5,
    "text": "横冲直撞觉得很舒服很会表现自己"
  },
  {
    "start": 490.5,
    "end": 495.75,
    "text": "别人就说他是匹夫之勇"
  },
  {
    "start": 495.75,
    "end": 500.75,
    "text": "他不懂用人不会聚才有才能的人不会在他那"
  },
  {
    "start": 500.75,
    "end": 504.5,
    "text": "所以他有匹夫之勇的名称"
  },
  {
    "start": 504.5,
    "end": 505.75,
    "text": "刚刚老高也说过了"
  },
  {
    "start": 505.75,
    "end": 510.75,
    "text": "他的匹夫之勇韩信了解的比较清楚"
  },
  {
    "start": 510.75,
    "end": 515.0,
    "text": "跟刘邦介绍项羽的缺点"
  },
  {
    "start": 515.0,
    "end": 520.75,
    "text": "匹夫之勇是在吴国与越国"
  },
  {
    "start": 520.75,
    "end": 528.5,
    "text": "两国战争的背景下产生这个典故"
  },
  {
    "start": 528.5,
    "end": 537.75,
    "text": "当时两国战争吴国夫差打赢了"
  },
  {
    "start": 537.75,
    "end": 542.75,
    "text": "把越国勾践抓起来当奴才"
  },
  {
    "start": 542.75,
    "end": 546.5,
    "text": "养马养牛养羊去做下等的事情"
  },
  {
    "start": 546.5,
    "end": 549.5,
    "text": "但是勾践都忍了"
  },
  {
    "start": 549.5,
    "end": 553.75,
    "text": "表面上服了假装着傻假装着癫"
  },
  {
    "start": 553.75,
    "end": 561.0,
    "text": "夫差看他服了也就心软了"
  },
  {
    "start": 561.0,
    "end": 564.0,
    "text": "三年后放他回去"
  },
  {
    "start": 564.0,
    "end": 567.25,
    "text": "放回去后卧薪尝胆"
  },
  {
    "start": 567.25,
    "end": 568.75,
    "text": "把苦胆挂门上"
  },
  {
    "start": 568.75,
    "end": 571.75,
    "text": "每天出门在苦胆上舔一下"
  },
  {
    "start": 571.75,
    "end": 572.5,
    "text": "很苦"
  },
  {
    "start": 572.5,
    "end": 577.5,
    "text": "经过十年的苦练养兵"
  },
  {
    "start": 577.5,
    "end": 579.75,
    "text": "国家强大复兴了"
  },
  {
    "start": 579.75,
    "end": 585.5,
    "text": "手下的部将有人信心很足说我们打过去"
  },
  {
    "start": 585.5,
    "end": 588.5,
    "text": "这时勾践说"
  },
  {
    "start": 588.5,
    "end": 591.0,
    "text": "一个人打不行"
  },
  {
    "start": 591.0,
    "end": 592.75,
    "text": "你一个人勇没用"
  },
  {
    "start": 592.75,
    "end": 594.0,
    "text": "要大家一起来"
  },
  {
    "start": 594.0,
    "end": 597.25,
    "text": "匹夫之勇是不够的"
  },
  {
    "start": 597.25,
    "end": 602.75,
    "text": "我们战胜吴王要靠大家一起来"
  },
  {
    "start": 602.75,
    "end": 605.75,
    "text": "要重用人才重用手下的人"
  },
  {
    "start": 605.75,
    "end": 609.0,
    "text": "才产生了匹夫之勇这句话"
  },
  {
    "start": 609.0,
    "end": 613.25,
    "text": "所以韩信引用匹夫之勇这句话"
  },
  {
    "start": 613.25,
    "end": 619.0,
    "text": "告诉刘邦项羽这个人有勇无谋"
  },
  {
    "start": 619.0,
    "end": 624.5,
    "text": "刘邦听了以后进一步了解项羽的弱点"
  },
  {
    "start": 624.5,
    "end": 628.75,
    "text": "这样说的话韩信确实有勇有谋"
  },
  {
    "start": 628.75,
    "end": 631.75,
    "text": "还有什么成语是跟韩信有关系的"
  },
  {
    "start": 631.75,
    "end": 635.0,
    "text": "就因为韩信有勇有谋"
  },
  {
    "start": 635.0,
    "end": 637.25,
    "text": "雄才伟略"
  },
  {
    "start": 637.25,
    "end": 643.25,
    "text": "所以司马迁在《史记淮阴侯列传》写到"
  },
  {
    "start": 643.25,
    "end": 646.25,
    "text": "此所谓功无二于天下"
  },
  {
    "start": 646.25,
    "end": 649.0,
    "text": "而略不世出者也"
  },
  {
    "start": 649.0,
    "end": 652.75,
    "text": "意思是说韩信这人谋略高明"
  },
  {
    "start": 652.75,
    "end": 656.75,
    "text": "世间少有很少这种人"
  },
  {
    "start": 656.75,
    "end": 660.75,
    "text": "此后就有了略不世出这句成语"
  },
  {
    "start": 660.75,
    "end": 667.75,
    "text": "还有一个典故是知其一不知其二"
  },
  {
    "start": 667.75,
    "end": 668.75,
    "text": "是什么故事"
  },
  {
    "start": 668.75,
    "end": 672.0,
    "text": "说到韩信的谋略"
  },
  {
    "start": 672.0,
    "end": 675.0,
    "text": "要提到刘邦手下还有的两个人"
  },
  {
    "start": 675.0,
    "end": 676.75,
    "text": "张良与萧何"
  },
  {
    "start": 676.75,
    "end": 679.25,
    "text": "这两个人也很厉害"
  },
  {
    "start": 679.25,
    "end": 688.75,
    "text": "刘邦在取得天下后在东都洛阳宴请文武百官"
  },
  {
    "start": 688.75,
    "end": 693.25,
    "text": "就问各位文武百官"
  },
  {
    "start": 693.25,
    "end": 697.0,
    "text": "我如今得天下"
  },
  {
    "start": 697.0,
    "end": 699.25,
    "text": "项羽已经先得天下"
  },
  {
    "start": 699.25,
    "end": 701.5,
    "text": "他开始就比我强大"
  },
  {
    "start": 701.5,
    "end": 705.75,
    "text": "为什么最后他会失败我会得天下"
  },
  {
    "start": 705.75,
    "end": 714.5,
    "text": "有两位臣子高起王陵两人回答说"
  },
  {
    "start": 714.5,
    "end": 718.5,
    "text": "项羽起初势力强大所以先有天下"
  },
  {
    "start": 718.5,
    "end": 723.0,
    "text": "但他妒忌手下的才能"
  },
  {
    "start": 723.0,
    "end": 729.25,
    "text": "得了土地也不分给他的部将"
  },
  {
    "start": 729.25,
    "end": 732.0,
    "text": "分享胜利果实"
  },
  {
    "start": 732.0,
    "end": 735.5,
    "text": "这是他失败的主要原因"
  },
  {
    "start": 735.5,
    "end": 740.75,
    "text": "汉王你为何能得天下呢"
  },
  {
    "start": 740.75,
    "end": 745.0,
    "text": "你得到地盘的时候谁功劳大"
  },
  {
    "start": 745.0,
    "end": 749.0,
    "text": "地盘就分给谁一起分享"
  },
  {
    "start": 749.5,
    "end": 751.25,
    "text": "所以你能得天下"
  },
  {
    "start": 751.25,
    "end": 754.5,
    "text": "刘邦这时候跟大家说"
  },
  {
    "start": 754.5,
    "end": 758.5,
    "text": "你们只知其一不知其二"
  },
  {
    "start": 758.5,
    "end": 762.5,
    "text": "运筹帷幄之间我不如张良"
  },
  {
    "start": 762.5,
    "end": 765.75,
    "text": "平定国家安抚国内百姓"
  },
  {
    "start": 765.75,
    "end": 770.5,
    "text": "抚恤百姓百姓才会种地才有粮食"
  },
  {
    "start": 770.5,
    "end": 772.0,
    "text": "我不如萧何"
  },
  {
    "start": 772.0,
    "end": 775.5,
    "text": "带领百万部队战争"
  },
  {
    "start": 775.5,
    "end": 778.5,
    "text": "战必胜攻必取"
  },
  {
    "start": 778.5,
    "end": 780.5,
    "text": "我不如韩信"
  },
  {
    "start": 780.5,
    "end": 784.25,
    "text": "我能得天下主要靠这三个大将"
  },
  {
    "start": 784.25,
    "end": 787.5,
    "text": "刘邦开头对韩信这么重用"
  },
  {
    "start": 787.5,
    "end": 793.5,
    "text": "为什么韩信最后会被刘邦从楚王贬为淮阴侯呢"
  },
  {
    "start": 793.5,
    "end": 797.5,
    "text": "韩信是西汉开国功臣"
  },
  {
    "start": 797.5,
    "end": 802.0,
    "text": "被刘邦封为齐王楚王上大将军等"
  },
  {
    "start": 802.0,
    "end": 807.0,
    "text": "韩信认为自己功劳很大就开始骄傲起来"
  },
  {
    "start": 807.0,
    "end": 813.5,
    "text": "刘邦察觉到韩信开始居功骄傲"
  },
  {
    "start": 813.5,
    "end": 815.5,
    "text": "就产生了不满"
  },
  {
    "start": 815.5,
    "end": 818.5,
    "text": "刘邦建立西汉政权不久"
  },
  {
    "start": 818.5,
    "end": 822.0,
    "text": "听到韩信想谋反的消息"
  },
  {
    "start": 822.0,
    "end": 826.5,
    "text": "就召集众位大臣来商量怎么办"
  },
  {
    "start": 826.5,
    "end": 834.5,
    "text": "几个武将建议立刻发兵擒拿韩信"
  },
  {
    "start": 834.5,
    "end": 841.75,
    "text": "刘邦手下有一个谋士叫陈平就问刘邦"
  },
  {
    "start": 841.75,
    "end": 846.75,
    "text": "告发韩信谋反的事有别人知道吗"
  },
  {
    "start": 846.75,
    "end": 849.75,
    "text": "刘邦说只有几员武将知道"
  },
  {
    "start": 849.75,
    "end": 853.0,
    "text": "陈平又问刘邦"
  },
  {
    "start": 853.0,
    "end": 857.25,
    "text": "韩信知道有人告发他谋反吗"
  },
  {
    "start": 857.25,
    "end": 860.25,
    "text": "刘邦说不知道"
  },
  {
    "start": 860.25,
    "end": 864.0,
    "text": "陈平说如果是这样那就好办了"
  },
  {
    "start": 864.0,
    "end": 867.0,
    "text": "陛下的兵力与韩信相比如何"
  },
  {
    "start": 867.0,
    "end": 870.5,
    "text": "刘邦说我比不过他"
  },
  {
    "start": 870.5,
    "end": 872.0,
    "text": "陈平又问"
  },
  {
    "start": 872.0,
    "end": 877.75,
    "text": "陛下指挥打仗的才能与韩信相比又如何"
  },
  {
    "start": 877.75,
    "end": 881.25,
    "text": "刘邦说我也比不过他"
  },
  {
    "start": 881.25,
    "end": 886.25,
    "text": "陈平又问既然能力不如韩信冒险举兵去讨伐"
  },
  {
    "start": 886.25,
    "end": 892.5,
    "text": "不就像鸡蛋碰石头以卵击石"
  },
  {
    "start": 892.5,
    "end": 899.0,
    "text": "刘邦说但我总不能束手无策等着韩信造反"
  },
  {
    "start": 899.0,
    "end": 902.75,
    "text": "陈平说陛下不必着急"
  },
  {
    "start": 902.75,
    "end": 907.5,
    "text": "臣有一计令韩信防不胜防"
  },
  {
    "start": 907.5,
    "end": 916.5,
    "text": "陛下只需用一名大力士将韩信擒来即可"
  },
  {
    "start": 916.5,
    "end": 921.0,
    "text": "说完轻轻向刘邦道出一条妙计"
  },
  {
    "start": 921.0,
    "end": 925.5,
    "text": "刘邦听完连连称妙妙哉妙哉"
  },
  {
    "start": 925.5,
    "end": 927.0,
    "text": "很好很好"
  },
  {
    "start": 927.0,
    "end": 928.75,
    "text": "是什么计谋呢"
  },
  {
    "start": 928.75,
    "end": 930.0,
    "text": "是这样"
  },
  {
    "start": 930.0,
    "end": 937.75,
    "text": "过去天子有离开京城巡视各地的例子"
  },
  {
    "start": 937.75,
    "end": 940.75,
    "text": "采纳陈平之计"
  },
  {
    "start": 940.75,
    "end": 945.75,
    "text": "刘邦也照古代天子做法去巡游"
  },
  {
    "start": 945.75,
    "end": 947.0,
    "text": "游哪里呢"
  },
  {
    "start": 947.0,
    "end": 950.25,
    "text": "游云梦湖"
  },
  {
    "start": 950.25,
    "end": 953.25,
    "text": "云梦湖也就是今天的洞庭湖"
  },
  {
    "start": 953.25,
    "end": 957.25,
    "text": "在那个地方会诸侯"
  },
  {
    "start": 957.25,
    "end": 963.25,
    "text": "会诸侯在韩信的地盘"
  },
  {
    "start": 963.25,
    "end": 965.5,
    "text": "韩信肯定会来"
  },
  {
    "start": 965.5,
    "end": 971.25,
    "text": "骗韩信我来这里是玩的"
  },
  {
    "start": 971.25,
    "end": 975.25,
    "text": "是来巡视的"
  },
  {
    "start": 975.25,
    "end": 979.75,
    "text": "韩信相信他们是来会诸侯的"
  },
  {
    "start": 979.75,
    "end": 982.75,
    "text": "礼节上也应该来"
  },
  {
    "start": 982.75,
    "end": 984.75,
    "text": "不来说明你想造反"
  },
  {
    "start": 984.75,
    "end": 989.0,
    "text": "天子来了你不来"
  },
  {
    "start": 989.0,
    "end": 990.25,
    "text": "所以他要来"
  },
  {
    "start": 990.25,
    "end": 995.0,
    "text": "来了之后在行礼下跪的时候就被抓了"
  },
  {
    "start": 995.0,
    "end": 997.25,
    "text": "按在地上绑起来"
  },
  {
    "start": 997.25,
    "end": 1001.0,
    "text": "绑回京城问罪"
  },
  {
    "start": 1001.0,
    "end": 1006.5,
    "text": "但是因为他功劳很大不能处理"
  },
  {
    "start": 1006.5,
    "end": 1011.0,
    "text": "他没有很明显的造反情节"
  },
  {
    "start": 1011.0,
    "end": 1012.5,
    "text": "不能把他杀掉"
  },
  {
    "start": 1012.5,
    "end": 1016.0,
    "text": "就处罚他"
  },
  {
    "start": 1016.0,
    "end": 1023.25,
    "text": "降级原来封王现在封侯"
  },
  {
    "start": 1023.25,
    "end": 1028.25,
    "text": "他是淮阴人就封了淮阴侯"
  },
  {
    "start": 1028.25,
    "end": 1032.0,
    "text": "这个故事就有了一个成语"
  },
  {
    "start": 1032.0,
    "end": 1034.75,
    "text": "伪游云梦"
  },
  {
    "start": 1034.75,
    "end": 1036.5,
    "text": "就是从这里来的"
  },
  {
    "start": 1036.5,
    "end": 1040.0,
    "text": "意思是采取阴谋诡计"
  },
  {
    "start": 1040.0,
    "end": 1044.5,
    "text": "也有只讲三个字游云梦"
  },
  {
    "start": 1044.5,
    "end": 1049.0,
    "text": "韩信被贬为淮阴侯后有没有收敛一点"
  },
  {
    "start": 1049.0,
    "end": 1053.0,
    "text": "免得刘邦对他产生怀疑要害他呢"
  },
  {
    "start": 1053.0,
    "end": 1055.75,
    "text": "韩信这人确实功劳很大"
  },
  {
    "start": 1055.75,
    "end": 1057.25,
    "text": "但是他有个缺点"
  },
  {
    "start": 1057.25,
    "end": 1061.0,
    "text": "心高气傲常居功自傲"
  },
  {
    "start": 1061.0,
    "end": 1069.0,
    "text": "有一次刘邦与韩信谈论各个将领的本领"
  },
  {
    "start": 1069.0,
    "end": 1072.25,
    "text": "刘邦指着自己问韩信"
  },
  {
    "start": 1072.25,
    "end": 1075.5,
    "text": "像我这样的人能带多少兵"
  },
  {
    "start": 1075.5,
    "end": 1080.25,
    "text": "韩信说你带兵不过十万人"
  },
  {
    "start": 1080.25,
    "end": 1083.25,
    "text": "刘邦又问韩信那么你带兵呢"
  },
  {
    "start": 1083.25,
    "end": 1085.25,
    "text": "韩信回答我带兵是越多越好"
  },
  {
    "start": 1085.25,
    "end": 1088.5,
    "text": "意思是我韩信有统兵之才"
  },
  {
    "start": 1088.5,
    "end": 1090.0,
    "text": "多多益善"
  },
  {
    "start": 1090.0,
    "end": 1093.0,
    "text": "刘邦笑着说"
  },
  {
    "start": 1093.0,
    "end": 1096.25,
    "text": "既然你的本领比我大为何要投靠我手下"
  },
  {
    "start": 1096.25,
    "end": 1100.0,
    "text": "韩信听到刘邦这句话吓了一跳清醒过来"
  },
  {
    "start": 1100.0,
    "end": 1102.0,
    "text": "赶紧转过来说"
  },
  {
    "start": 1102.0,
    "end": 1106.0,
    "text": "我虽然会带兵还是你比我厉害"
  },
  {
    "start": 1106.0,
    "end": 1110.75,
    "text": "因为你擅长统帅将领"
  },
  {
    "start": 1110.75,
    "end": 1113.5,
    "text": "所有带兵将领都是你统帅"
  },
  {
    "start": 1113.5,
    "end": 1115.75,
    "text": "你最厉害"
  },
  {
    "start": 1115.75,
    "end": 1118.0,
    "text": "刘邦听了微微带笑"
  },
  {
    "start": 1118.0,
    "end": 1122.25,
    "text": "等于韩信过了这一关了"
  },
  {
    "start": 1122.25,
    "end": 1127.0,
    "text": "从此就留下多多益善这个成语"
  },
  {
    "start": 1127.0,
    "end": 1131.5,
    "text": "韩信点兵多多益善"
  },
  {
    "start": 1131.5,
    "end": 1135.5,
    "text": "刘邦和韩信之间的矛盾什么时候变大变深了呢"
  },
  {
    "start": 1135.5,
    "end": 1137.25,
    "text": "这里已经开始有矛盾了"
  },
  {
    "start": 1137.25,
    "end": 1143.0,
    "text": "天下得到了功臣之间就有矛盾"
  },
  {
    "start": 1143.0,
    "end": 1146.5,
    "text": "因为利益分配的矛盾"
  },
  {
    "start": 1146.5,
    "end": 1151.25,
    "text": "有一次韩信带军队去攻打齐国"
  },
  {
    "start": 1151.25,
    "end": 1159.75,
    "text": "齐国攻破后没有向刘邦汇报现在什么情况"
  },
  {
    "start": 1159.75,
    "end": 1163.75,
    "text": "韩信自傲封王"
  },
  {
    "start": 1163.75,
    "end": 1167.0,
    "text": "他说我先代理齐王"
  },
  {
    "start": 1167.0,
    "end": 1172.5,
    "text": "这时刘邦也在战争中他在攻打荥阳"
  },
  {
    "start": 1172.5,
    "end": 1175.75,
    "text": "久攻不下城池"
  },
  {
    "start": 1175.75,
    "end": 1181.25,
    "text": "正在烦火看到韩信的信息"
  },
  {
    "start": 1181.25,
    "end": 1183.5,
    "text": "我没有封你你就代理"
  },
  {
    "start": 1183.5,
    "end": 1186.0,
    "text": "不舒服怒火中烧"
  },
  {
    "start": 1186.0,
    "end": 1188.5,
    "text": "谋士张良跟他说"
  },
  {
    "start": 1188.5,
    "end": 1190.25,
    "text": "不要这样急"
  },
  {
    "start": 1190.25,
    "end": 1194.25,
    "text": "劝他说韩信现在势力大"
  },
  {
    "start": 1194.25,
    "end": 1200.25,
    "text": "他的部队现在攻打我们我们打不过"
  },
  {
    "start": 1200.25,
    "end": 1201.5,
    "text": "你都别急"
  },
  {
    "start": 1201.5,
    "end": 1207.0,
    "text": "刘邦被点破恍然大悟"
  },
  {
    "start": 1207.0,
    "end": 1215.5,
    "text": "改口道大丈夫灭诸侯立大功就要做王"
  },
  {
    "start": 1215.5,
    "end": 1219.5,
    "text": "也不用代理我直接封给你"
  },
  {
    "start": 1219.5,
    "end": 1224.0,
    "text": "就派张良拿着印去封他为王"
  },
  {
    "start": 1224.0,
    "end": 1226.25,
    "text": "韩信就做了齐王"
  },
  {
    "start": 1226.25,
    "end": 1232.0,
    "text": "这次开始刘邦对韩信越来越不满"
  },
  {
    "start": 1232.0,
    "end": 1235.25,
    "text": "慢慢后来矛盾也激化了"
  },
  {
    "start": 1235.25,
    "end": 1241.75,
    "text": "韩信这种居功骄傲的性格肯定会害了他自己"
  },
  {
    "start": 1241.75,
    "end": 1245.5,
    "text": "不过韩信并不是死在刘邦手里"
  },
  {
    "start": 1245.5,
    "end": 1249.5,
    "text": "刘邦当了皇帝以后5年"
  },
  {
    "start": 1249.5,
    "end": 1255.5,
    "text": "这时有个叫陈稀的人想造反"
  },
  {
    "start": 1255.5,
    "end": 1257.25,
    "text": "自称代王"
  },
  {
    "start": 1257.25,
    "end": 1259.25,
    "text": "这“代”不是代替的"
  },
  {
    "start": 1259.25,
    "end": 1266.0,
    "text": "当时有个国家叫代国是代国的王"
  },
  {
    "start": 1266.0,
    "end": 1271.0,
    "text": "代国就在现如今河北省境内"
  },
  {
    "start": 1271.0,
    "end": 1276.75,
    "text": "刘邦见其造反就亲自率兵前去讨伐"
  },
  {
    "start": 1276.75,
    "end": 1284.75,
    "text": "讨伐时韩信称病不随刘邦出征"
  },
  {
    "start": 1284.75,
    "end": 1289.5,
    "text": "并且暗中派人跟陈稀联系"
  },
  {
    "start": 1289.5,
    "end": 1294.25,
    "text": "叫陈稀只管起兵"
  },
  {
    "start": 1294.25,
    "end": 1299.5,
    "text": "我会暗中在京城内策应"
  },
  {
    "start": 1299.5,
    "end": 1302.75,
    "text": "韩信与家臣谋划"
  },
  {
    "start": 1302.75,
    "end": 1306.25,
    "text": "可以在夜里假传诏旨"
  },
  {
    "start": 1306.25,
    "end": 1313.0,
    "text": "放那些关在牢中的囚徒"
  },
  {
    "start": 1313.0,
    "end": 1319.75,
    "text": "然后率领他们去宫中袭击吕后"
  },
  {
    "start": 1319.75,
    "end": 1321.75,
    "text": "吕后就是刘邦的妻子"
  },
  {
    "start": 1321.75,
    "end": 1323.0,
    "text": "以及太子"
  },
  {
    "start": 1323.0,
    "end": 1327.0,
    "text": "刚好这时韩信的一位门客得罪了韩信"
  },
  {
    "start": 1327.0,
    "end": 1330.0,
    "text": "韩信抓了他并准备杀掉"
  },
  {
    "start": 1330.0,
    "end": 1332.25,
    "text": "此门客有个弟弟"
  },
  {
    "start": 1332.25,
    "end": 1335.75,
    "text": "弟弟知道韩信的计谋"
  },
  {
    "start": 1335.75,
    "end": 1339.0,
    "text": "弟弟看见哥哥被韩信抓了不甘心"
  },
  {
    "start": 1339.0,
    "end": 1343.75,
    "text": "就把韩信的计谋向吕后密告"
  },
  {
    "start": 1343.75,
    "end": 1348.75,
    "text": "吕后知道后就与萧何商量"
  },
  {
    "start": 1348.75,
    "end": 1352.0,
    "text": "萧何是相国嘛就与他商量怎么办"
  },
  {
    "start": 1352.0,
    "end": 1356.25,
    "text": "萧何教吕后"
  },
  {
    "start": 1356.25,
    "end": 1361.5,
    "text": "我们把韩信骗进皇宫抓起来"
  },
  {
    "start": 1361.5,
    "end": 1365.5,
    "text": "吕后说他会听你的话"
  },
  {
    "start": 1365.5,
    "end": 1374.0,
    "text": "萧何就与韩信说陈稀造反失败已经被抓"
  },
  {
    "start": 1374.0,
    "end": 1378.75,
    "text": "诸侯群臣都进宫朝贺"
  },
  {
    "start": 1378.75,
    "end": 1382.25,
    "text": "你虽然有病还是要勉强去朝贺一下"
  },
  {
    "start": 1382.25,
    "end": 1384.25,
    "text": "不然别人会怀疑你"
  },
  {
    "start": 1384.25,
    "end": 1389.5,
    "text": "韩信听后觉得确实要进宫一下"
  },
  {
    "start": 1389.5,
    "end": 1392.5,
    "text": "不进宫会引起怀疑"
  },
  {
    "start": 1392.5,
    "end": 1394.0,
    "text": "就进宫朝贺"
  },
  {
    "start": 1394.0,
    "end": 1397.25,
    "text": "吕后见韩信一来就抓起来"
  },
  {
    "start": 1397.25,
    "end": 1405.5,
    "text": "抓起来后就在长乐宫的钟室"
  },
  {
    "start": 1405.5,
    "end": 1407.25,
    "text": "存放大钟的钟室里"
  },
  {
    "start": 1407.25,
    "end": 1412.5,
    "text": "斩杀了韩信并诛灭三族"
  },
  {
    "start": 1412.5,
    "end": 1415.75,
    "text": "果然韩信因为居功骄傲"
  },
  {
    "start": 1415.75,
    "end": 1418.0,
    "text": "功高盖主害了自己"
  },
  {
    "start": 1418.0,
    "end": 1422.5,
    "text": "那么从韩信的死造出什么成语呢"
  },
  {
    "start": 1422.5,
    "end": 1425.5,
    "text": "这个事件引出三个成语"
  },
  {
    "start": 1425.5,
    "end": 1427.25,
    "text": "钟室之祸"
  },
  {
    "start": 1427.25,
    "end": 1431.0,
    "text": "就是刚刚说韩信相信了萧何的话"
  },
  {
    "start": 1431.0,
    "end": 1436.5,
    "text": "进入皇宫被吕后抓起来在钟室里面杀掉"
  },
  {
    "start": 1436.5,
    "end": 1443.75,
    "text": "也就是说过分相信别人会惹来杀身之祸"
  },
  {
    "start": 1443.75,
    "end": 1445.75,
    "text": "还有一个成语是"
  },
  {
    "start": 1445.75,
    "end": 1449.0,
    "text": "成也萧何败也萧何"
  },
  {
    "start": 1449.0,
    "end": 1453.75,
    "text": "因为韩信是由萧何推荐的"
  },
  {
    "start": 1453.75,
    "end": 1457.5,
    "text": "做到了大将军这是成功的"
  },
  {
    "start": 1457.5,
    "end": 1458.5,
    "text": "功劳很大"
  },
  {
    "start": 1458.5,
    "end": 1462.5,
    "text": "后来想谋反"
  },
  {
    "start": 1462.5,
    "end": 1464.75,
    "text": "（萧何）就把韩信骗到宫里"
  },
  {
    "start": 1464.75,
    "end": 1466.75,
    "text": "引来杀身之祸"
  },
  {
    "start": 1466.75,
    "end": 1468.5,
    "text": "败也是萧何"
  },
  {
    "start": 1468.5,
    "end": 1474.25,
    "text": "韩信的一生成功也是萧何失败也是萧何"
  },
  {
    "start": 1474.25,
    "end": 1478.0,
    "text": "赏识是他识破也是他"
  },
  {
    "start": 1478.0,
    "end": 1483.5,
    "text": "这里引出的第三个成语最精彩"
  },
  {
    "start": 1483.5,
    "end": 1488.0,
    "text": "就是生死一知己存亡两妇人"
  },
  {
    "start": 1488.0,
    "end": 1490.75,
    "text": "生死一知己这个知己就是萧何"
  },
  {
    "start": 1490.75,
    "end": 1498.0,
    "text": "萧何极力推荐他相信他让他做大将军"
  },
  {
    "start": 1498.0,
    "end": 1501.0,
    "text": "两妇人就是两个女人"
  },
  {
    "start": 1501.0,
    "end": 1507.25,
    "text": "一个就是韩信最艰难的时候救济他的漂母"
  },
  {
    "start": 1507.25,
    "end": 1509.0,
    "text": "洗衣服的老婆婆"
  },
  {
    "start": 1509.0,
    "end": 1510.75,
    "text": "吕后也是女人"
  },
  {
    "start": 1510.75,
    "end": 1516.0,
    "text": "吕后把韩信抓起来是为了让他死亡"
  },
  {
    "start": 1516.0,
    "end": 1520.75,
    "text": "生死一知己存亡两妇人"
  },
  {
    "start": 1520.75,
    "end": 1526.0,
    "text": "这整个成语就反映了韩信一生"
  },
  {
    "start": 1526.0,
    "end": 1530.25,
    "text": "由辉煌到失败最后死亡"
  },
  {
    "start": 1530.25,
    "end": 1534.0,
    "text": "人生整个过程都在里面了"
  },
  {
    "start": 1534.0,
    "end": 1537.75,
    "text": "总结一下韩信这个人有大将之才"
  },
  {
    "start": 1537.75,
    "end": 1541.0,
    "text": "但是过分自信居功骄傲"
  },
  {
    "start": 1541.0,
    "end": 1543.5,
    "text": "以至于功高震主"
  },
  {
    "start": 1543.5,
    "end": 1545.0,
    "text": "引来杀身之祸"
  },
  {
    "start": 1545.0,
    "end": 1549.5,
    "text": "从这个角度来说害死韩信的不是别人"
  },
  {
    "start": 1549.5,
    "end": 1550.75,
    "text": "是他自己"
  },
  {
    "start": 1550.75,
    "end": 1552.5,
    "text": "关于韩信的故事"
  },
  {
    "start": 1552.5,
    "end": 1555.25,
    "text": "以及由他的故事造出的成语"
  },
  {
    "start": 1555.25,
    "end": 1557.781,
    "text": "我们就讲到这里"
  }
]
